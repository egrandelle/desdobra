{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:desdobra:schema:estado:1",
  "title": "Estado do job (estado/1)",
  "description": "Fases, portoes, hash das entradas de cada fase e proxima acao. Gravado so pelo motor, de forma atomica.",
  "type": "object",
  "additionalProperties": false,
  "required": ["esquema", "job_id", "criado_em", "atualizado_em", "motor_versao", "modo_dados", "teto_modo_dados",
               "entradas", "fases", "proxima"],
  "properties": {
    "esquema": {"const": "estado/1"},
    "job_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "criado_em": {"$ref": "#/$defs/instante"},
    "atualizado_em": {"$ref": "#/$defs/instante"},
    "motor_versao": {"type": "string"},
    "modo_dados": {"$ref": "#/$defs/modo"},
    "teto_modo_dados": {"oneOf": [{"$ref": "#/$defs/modo"}, {"type": "null"}]},
    "entradas": {
      "description": "Arquivos congelados em entrada/, por caminho relativo a pasta do job (com /)",
      "type": "object",
      "propertyNames": {"pattern": "^entrada/[^\\\\]+$"},
      "additionalProperties": {"$ref": "#/$defs/entrada"}
    },
    "fases": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id_fase"},
      "additionalProperties": {"$ref": "#/$defs/fase"}
    },
    "proxima": {"$ref": "#/$defs/proxima"}
  },
  "$defs": {
    "instante": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"},
    "modo": {"enum": ["a", "b", "c"]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id_fase": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "entrada": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes", "congelada_em"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "congelada_em": {"$ref": "#/$defs/instante"}
      }
    },
    "fase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["situacao", "hash_entradas", "tentativas"],
      "properties": {
        "situacao": {
          "description": "pendente: nunca rodou; concluida: rodou com codigo 0; falhou: codigo diferente de zero; invalidada: uma entrada mudou depois de concluida; aguardando_portao: portao humano ainda nao cumprido",
          "enum": ["pendente", "concluida", "falhou", "invalidada", "aguardando_portao"]
        },
        "hash_entradas": {
          "description": "sha256 de cada entrada da fase no momento em que ela rodou (arquivo ou pasta; null se nao existia)",
          "type": "object",
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        },
        "hash_saidas": {
          "description": "sha256 de cada saida da fase no momento em que ela concluiu; saida apagada ou mudada depois invalida a fase",
          "type": "object",
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
        },
        "tentativas": {"type": "integer", "minimum": 0},
        "opcoes": {
          "description": "Opcoes do job proxima com que a fase rodou pela ultima vez (o teto confirmado pelo DA); opcoes diferentes num job proxima seguinte invalidam a fase concluida",
          "type": "array",
          "items": {"type": "string"}
        },
        "codigo": {"type": ["integer", "null"]},
        "inicio": {"oneOf": [{"$ref": "#/$defs/instante"}, {"type": "null"}]},
        "fim": {"oneOf": [{"$ref": "#/$defs/instante"}, {"type": "null"}]},
        "duracao_s": {"type": ["number", "null"]},
        "motivo": {
          "description": "Texto fixo do motor (nunca conteudo do job), por exemplo a lista de entradas que mudaram",
          "type": ["string", "null"]
        },
        "bloqueio": {
          "description": "Bloqueio com que a fase terminou (so nas fases com bloqueio_persiste, como a conferencia de fontes). Fica ate a fase rodar de novo sem bloqueio; enquanto existe numa fase valida, o job nao fica concluido",
          "type": "object",
          "additionalProperties": false,
          "required": ["situacao", "o_que_fazer", "contagens"],
          "properties": {
            "situacao": {"enum": ["ok_com_bloqueio", "bloqueado"]},
            "o_que_fazer": {"type": "string", "description": "Texto fixo do motor que a fase mandou"},
            "contagens": {"type": "object", "additionalProperties": {"type": "integer"}}
          }
        }
      }
    },
    "proxima": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "fase", "o_que_fazer"],
      "properties": {
        "tipo": {"enum": ["fase", "portao", "falha", "bloqueio", "concluido"], "description": "bloqueio: todas as fases estao validas, mas uma terminou com bloqueio que continua pendente"},
        "fase": {"oneOf": [{"$ref": "#/$defs/id_fase"}, {"type": "null"}]},
        "o_que_fazer": {"type": "string"}
      }
    }
  }
}
