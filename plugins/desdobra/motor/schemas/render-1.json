{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:desdobra:schema:render:1",
  "title": "Registro do render de um formato (render/1)",
  "description": "render/<formato>/render.json (arquitetura-v1.md, 4.11 e 9.5): versoes do Chromium e das bibliotecas, G, tempos, o sha256 de cada fonte e de cada asset usado, o resultado da conferencia por CDP, o teste de cache do perfil do Chromium e a varredura da pasta do job. Sem texto de peca, sem caminho de fonte e sem byte de fonte.",
  "type": "object",
  "additionalProperties": false,
  "required": ["esquema", "job_id", "formato", "gerado_em", "motor_versao", "disparo", "versoes", "parametros",
               "contrato_sha256", "master", "fontes", "cdp", "cache", "varredura", "assets", "aceites", "registros",
               "textos", "tempos", "tempo_s"],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
  "properties": {
    "esquema": {"const": "render/1"},
    "job_id": {"type": "string"},
    "formato": {"type": "object", "required": ["chave", "largura", "altura"]},
    "gerado_em": {"type": "string"},
    "motor_versao": {"type": "string"},
    "disparo": {"type": "object", "required": ["meio", "quando"],
                "properties": {"meio": {"enum": ["terminal", "tela", "medicao"]}, "usuario": {"type": ["string", "null"]},
                               "maquina": {"type": ["string", "null"]}, "quando": {"type": "string"}}},
    "versoes": {"type": "object", "required": ["chromium", "playwright", "pypdfium2", "pdfium"]},
    "parametros": {"type": "object", "required": ["gama", "supersample", "cor"]},
    "contrato_sha256": {"$ref": "#/$defs/sha256"},
    "master": {"type": "object", "required": ["arquivo", "sha256", "largura", "altura", "modo"],
               "properties": {"sha256": {"$ref": "#/$defs/sha256"}}},
    "fontes": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                          "required": ["face_id", "sha256", "nome_ps", "formato"],
                                          "properties": {"face_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"},
                                                         "nome_ps": {"type": ["string", "null"]}, "formato": {"type": "string"}}}},
    "cdp": {"type": "object", "required": ["trechos", "confere", "diverge", "sem_resposta"],
            "properties": {"trechos": {"type": "integer", "minimum": 0}, "confere": {"type": "integer", "minimum": 0},
                           "diverge": {"type": "integer", "minimum": 0}, "sem_resposta": {"type": "integer", "minimum": 0}}},
    "cache": {"type": "object", "required": ["feito", "copias_encontradas", "pdfs_encontrados", "perfil_apagado", "cache_control"]},
    "varredura": {"type": "object", "required": ["arquivos_de_fonte_fora_da_entrada", "pdfs_no_job"]},
    "assets": {"type": "array", "items": {"type": "object", "required": ["tipo", "entrada", "sha256"],
                                          "properties": {"tipo": {"enum": ["pilha", "linkado"]},
                                                         "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}}},
    "pilhas_do_cache": {"type": "integer", "minimum": 0},
    "aceites": {"type": "array", "items": {"type": "object", "required": ["codigo"]}},
    "registros": {"type": "array", "items": {"type": "object", "required": ["codigo"]}},
    "curva": {"type": ["object", "null"]},
    "conversao_cor": {"type": ["object", "null"]},
    "entradas": {"type": "array"},
    "textos": {"type": "object", "required": ["camadas", "sharp_pequeno", "paginas_pdf"]},
    "recursos": {"type": "object"},
    "tempos": {"type": "object"},
    "tempo_s": {"type": "number", "minimum": 0}
  }
}
