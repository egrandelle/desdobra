{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:desdobra:schema:relatorio-entrega:1",
  "title": "Relatorio da entrega (relatorio-entrega/1)",
  "description": "entrega/relatorio-entrega.json (arquitetura-v1.md, 5.9 e 9.7), gravado so pelo \"desdobra entregar\" num terminal interativo, junto com entrega/aprovados e entrega/reprovados. Um registro por arquivo entregue (o formato que o encoder recusou por decisao ou folha que falta, como a cor de achatamento de um master com transparencia, fica em reprovados com sha256, bytes e extensao nulos e sem arquivo): formato, nome, pasta, sha256, bytes, MIME, dimensao, parametros do encoder e cada verificacao (situacao, regra, fonte, medidas e, quando reprova, a sugestao), os hashes de origem, a aprovacao do formato e o que mudou desde a entrega anterior. Mais o ambiente (versoes do encoder desta build contra a referencia, versoes do render e sha256 das fontes usadas), a citacao de cada limite da entrega, de onde vem cada numero fora de verificacao com fonte (fontes_dos_campos: nenhum numero sem fonte), o resumo (passou, avisou, so registro) e o sha256 do manifesto-licenca.json da raiz do job. Sem texto de peca. relatorio_sha256 e o sha256 do relatorio sem esse campo: o \"desdobra conferir-entrega\" so le e confere os arquivos de entrega/ contra estes hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["esquema", "job_id", "gerado_em", "carimbo", "motor_versao", "entregue_por", "contagens", "arquivos",
               "ambiente", "limites", "fontes_dos_campos", "entrega_anterior", "manifesto_sha256", "resumo",
               "relatorio_sha256"],
  "properties": {
    "esquema": {"const": "relatorio-entrega/1"},
    "job_id": {"type": "string", "minLength": 1},
    "gerado_em": {"type": "string"},
    "carimbo": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}[+-][0-9]{4}$"},
    "motor_versao": {"type": "string"},
    "entregue_por": {"type": "object", "required": ["meio", "quando"],
                     "properties": {"usuario": {"type": ["string", "null"]}, "maquina": {"type": ["string", "null"]},
                                    "meio": {"enum": ["terminal", "tela"]}, "quando": {"type": "string"}}},
    "contagens": {"type": "object", "required": ["aprovados", "reprovados"],
                  "properties": {"aprovados": {"type": "integer", "minimum": 0},
                                 "reprovados": {"type": "integer", "minimum": 0}}},
    "arquivos": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["formato", "nome", "pasta", "sha256", "bytes", "mime", "largura", "altura", "extensao",
                     "parametros_encoder", "medidas_encoder", "verificacoes", "regras", "sugestoes", "origem",
                     "aprovacao", "mudou_desde_a_entrega_anterior"],
        "properties": {
          "formato": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "nome": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "pasta": {"enum": ["aprovados", "reprovados"]},
          "sha256": {"$ref": "#/$defs/sha256_ou_nulo"},
          "bytes": {"type": ["integer", "null"], "minimum": 0},
          "mime": {"type": ["string", "null"]},
          "largura": {"type": ["integer", "null"]},
          "altura": {"type": ["integer", "null"]},
          "extensao": {"enum": ["jpg", "png", null]},
          "parametros_encoder": {"type": "object"},
          "medidas_encoder": {"type": "object"},
          "verificacoes": {
            "type": "array",
            "items": {"type": "object", "required": ["nome", "situacao", "regra", "fonte"],
                      "properties": {"nome": {"type": "string"},
                                     "situacao": {"enum": ["ok", "reprova", "avisa", "registra"]},
                                     "regra": {"type": ["string", "null"]},
                                     "fonte": {"type": ["object", "null"]},
                                     "descricao": {"type": "string"},
                                     "sugestao": {"type": "string"},
                                     "medidas": {"type": "object"}}}
          },
          "regras": {"type": "array", "items": {"type": "string"}},
          "sugestoes": {"type": "array", "items": {"type": "string"}},
          "origem": {"type": ["object", "null"],
                     "description": "Os hashes medidos agora pelo portao: a impressao do formato (M7b, A2), o master, o render.json e o contrato. O briefing_sha256 e o do relatorio de antes do M7b",
                     "properties": {"impressao_formato": {"$ref": "#/$defs/sha256_ou_nulo"},
                                    "briefing_sha256": {"$ref": "#/$defs/sha256_ou_nulo"},
                                    "master_sha256": {"$ref": "#/$defs/sha256_ou_nulo"},
                                    "render_json_sha256": {"$ref": "#/$defs/sha256_ou_nulo"},
                                    "contrato_sha256": {"$ref": "#/$defs/sha256_ou_nulo"}}},
          "aprovacao": {"type": ["object", "null"], "additionalProperties": false,
                        "required": ["registro_sha256", "aprovado_em", "diferencas"],
                        "properties": {"registro_sha256": {"$ref": "#/$defs/sha256_ou_nulo"},
                                       "aprovado_em": {"type": ["string", "null"]},
                                       "diferencas": {"type": "array", "items": {"type": "string"}}}},
          "mudou_desde_a_entrega_anterior": {"type": ["array", "null"], "items": {"type": "string"}}
        }
      }
    },
    "ambiente": {"type": "object", "additionalProperties": false, "required": ["encoder", "render"],
                 "properties": {
                   "encoder": {"type": "object", "required": ["versoes", "referencia", "difere"],
                               "properties": {"versoes": {"type": "object",
                                                          "required": ["pillow", "libjpeg_turbo", "zlib"]},
                                              "referencia": {"type": "object", "required": ["limite_id"]},
                                              "difere": {"type": "array", "items": {"type": "string"}}}},
                   "render": {"type": "object", "required": ["versoes", "fontes_sha256"],
                              "properties": {"versoes": {"type": "array", "items": {"type": "object"}},
                                             "fontes_sha256": {"type": "array",
                                                               "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
                 }},
    "limites": {"type": "array", "items": {"type": "object", "required": ["limite_id", "valor", "fonte", "situacao",
                                                                          "efeito"]}},
    "fontes_dos_campos": {"type": "object", "additionalProperties": {"type": "object"}},
    "entrega_anterior": {"type": ["string", "null"]},
    "manifesto_sha256": {"$ref": "#/$defs/sha256_ou_nulo"},
    "resumo": {"type": "object", "additionalProperties": false,
               "required": ["verificacoes", "aprovados_sem_aviso", "avisos", "registros"],
               "properties": {"verificacoes": {"type": "object", "required": ["passou", "avisou", "so_registro", "reprovou"],
                                               "additionalProperties": {"type": "integer", "minimum": 0}},
                              "aprovados_sem_aviso": {"type": "integer", "minimum": 0},
                              "avisos": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
                              "registros": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}},
    "relatorio_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sha256_ou_nulo": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
